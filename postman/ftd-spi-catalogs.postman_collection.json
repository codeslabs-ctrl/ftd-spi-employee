                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('trae paginacion', () => pm.expect(pm.response.json().page).to.eql(1));",
                  "pm.test('items es array', () => pm.expect(pm.response.json().items).to.be.an('array'));"
